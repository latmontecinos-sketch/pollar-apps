{
  "name": "event-tickets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:probe": "node --env-file-if-exists=.env --env-file-if-exists=.env.development.local scripts/db-probe.mjs",
    "spike:capacity": "node --env-file-if-exists=.env --env-file-if-exists=.env.development.local scripts/spike-capacity.mts",
    "spike:door": "node --env-file-if-exists=.env --env-file-if-exists=.env.development.local scripts/spike-door.mts",
    "spike:horizon-verify": "node --env-file-if-exists=.env --env-file-if-exists=.env.development.local scripts/spike-horizon-verify.mts",
    "test": "node --test tests/*.test.mts",
    "audit": "pnpm audit --audit-level high",
    "db:probe:prod": "node --env-file=.env.ops scripts/db-probe.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@pollar/core": "^0.11.2",
    "@pollar/react": "^0.11.2",
    "next": "16.3.5",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@stellar/stellar-base": "15.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "overrides": {
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2"
    }
  }
}
