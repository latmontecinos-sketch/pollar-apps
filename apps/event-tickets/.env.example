# Pollar publishable key — safe to expose in the frontend.
# Get it at dashboard.pollar.xyz → Build → API Keys → Generate (type: Publishable).
# Use pub_testnet_… while developing; switch to pub_mainnet_… for production.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=pub_testnet_xxxxxxxxxxxxxxxxxxxx

# Optional: prefills the recipient field of the demo payment on the home page.
# Any Pollar account address (G…) works — e.g. a second test account of yours.
# NEXT_PUBLIC_DEMO_RECIPIENT=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Pollar secret key — backend only (API routes), never expose it client-side.
# Only needed for privileged server calls (e.g. Deferred-mode wallet activation).
# Same place in the dashboard (type: Secret) — it is shown only once, store it safely.
# POLLAR_SECRET_KEY=sec_testnet_xxxxxxxxxxxxxxxxxxxx

# Optional: sends the ticket by email after a successful purchase (best-effort,
# never blocks the purchase). Free at resend.com — without a verified domain,
# resend.dev only delivers to the email on your own Resend account, which is
# fine for testing.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Base de datos ─────────────────────────────────────────────────────────────
# Local: dejar sin definir. La app usa file:./dev.db y no hace falta nada mas.
# Produccion (Vercel): OBLIGATORIO. Sin esto el arranque falla con error explicito;
# nunca cae de vuelta al archivo local, porque en Vercel el filesystem no persiste
# ni se comparte entre invocaciones y el sistema pareceria andar mientras pierde datos.
# DATABASE_URL=libsql://tu-base.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOi...

# ── Que va en cada archivo ────────────────────────────────────────────────────
# .env                     solo desarrollo. Lo cargan `next dev` y todos los
#                          scripts (db:probe, spikes), asi que una credencial de
#                          produccion aca escribe en la base real sin avisar.
# .env.development.local   sobreescribe .env para tu maquina (base local).
# .env.ops                 copia de emergencia de las credenciales de produccion.
#                          Ningun script lo carga solo: hay que pedirlo a mano
#                          (`pnpm db:probe:prod`). Tampoco se llama .env.production.local
#                          a proposito: ese nombre lo cargaria `next build` local.
# Vercel                   la fuente de verdad de produccion. Marca DATABASE_URL,
#                          DATABASE_AUTH_TOKEN y RESEND_API_KEY como "Sensitive"
#                          para que no se puedan volver a leer desde el panel.

# ── Red de Stellar ───────────────────────────────────────────────────────────
# NO hace falta configurar nada: la red sale del prefijo de la publishable key
# (pub_testnet_ / pub_mainnet_) y lib/network.ts deriva de ahi el emisor de USDC
# esperado, la URL de Horizon y los links al explorador. Una sola fuente de verdad.
#
# HORIZON_URL solo se define para apuntar a un Horizon propio o local. Si
# contradice a la publishable key (key de mainnet + Horizon de testnet, o al
# reves), la app se niega a arrancar con un error explicito en vez de verificar
# los pagos contra una cadena donde nunca ocurrieron.
# HORIZON_URL=https://horizon.stellar.org
#
# USDC_ISSUER solo para fijar otro emisor (un activo de prueba propio). Es
# server-only a proposito: el cliente paga el activo que le dice la venta
# (app/api/sales), nunca uno que elija por su cuenta.
# USDC_ISSUER=GA5ZSEJYB37JRC5JMCP5ZJYS4ENFSOFAKTOWYFCLJXSN5M5X3TMXCY4I

# Origen publico de la app, p.ej. https://pollarpass.vercel.app
# Lo usa el correo para armar la URL del QR. Sin esto se cae al Host de la
# peticion, que lo controla quien llama: un Host falsificado haria que el QR
# del correo apunte a otro servidor.
# APP_ORIGIN=https://pollarpass.vercel.app
